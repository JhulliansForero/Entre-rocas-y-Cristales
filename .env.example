# ============================================================
# Entre Rocas y Cristales — Variables de entorno
# Copia este archivo como .env y completa los valores reales
# NUNCA subas .env al repositorio
# ============================================================

# ─── Django ──────────────────────────────────────────────────
# Genera con: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=django-insecure-cambia-esto-por-una-clave-real-de-50-chars-minimo
DEBUG=0
DJANGO_SETTINGS_MODULE=config.settings.production
TIME_ZONE=America/Bogota

# ─── Base de datos ────────────────────────────────────────────
DB_NAME=entre_rocas_db
DB_USER=entre_rocas_user
DB_PASSWORD=cambia_esta_password_segura
DB_HOST=db
DB_PORT=5432

# ─── Hosts permitidos (separados por coma, sin espacios) ──────
ALLOWED_HOSTS=tudominio.com,www.tudominio.com

# ─── CORS — orígenes del frontend ─────────────────────────────
CORS_ALLOWED_ORIGINS=https://tudominio.com,https://www.tudominio.com

# ─── Frontend — URL base de la API ────────────────────────────
VITE_API_URL=https://tudominio.com/api
